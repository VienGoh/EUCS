generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ====================
// TABEL UTAMA
// ====================

// Admin/Peneliti
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(RESEARCHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relasi
  surveys Survey[]
  exports Export[]
  
  @@map("users")
}

enum UserRole {
  RESEARCHER
  ADMIN
}

// Responden Penelitian
model Respondent {
  id              String   @id @default(cuid())
  name            String
  age             Int
  gender          String   // "Laki-laki" | "Perempuan"
  email           String?  @unique
  phone           String?
  occupation      String
  education       String?
  incomeRange     String?  // "< 3jt", "3-5jt", "5-10jt", "> 10jt"
  tiktokUsage     Int      // 1-5 (Likert Scale)
  tiktokShopUsage Int      // 1-5 (Likert Scale)
  lastPurchase    DateTime
  createdAt       DateTime @default(now())
  
  // Relasi
  surveys Survey[]
  
  @@map("respondents")
}

// Kuesioner/Survei
model Survey {
  id           String   @id @default(cuid())
  respondentId String
  researcherId String
  completed    Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  
  // Relasi
  respondent Respondent @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  researcher User       @relation(fields: [researcherId], references: [id], onDelete: Cascade)
  answers    Answer[]
  analysis   Analysis?
  
  @@map("surveys")
}

// ====================
// DIMENSI EUCS
// ====================

// Dimensi EUCS dan Loyalty
model Dimension {
  id          String   @id @default(cuid())
  name        String   @unique  // Content, Accuracy, Format, EaseOfUse, Timeliness, Loyalty
  description String
  indicators  String   // JSON string array
  
  // Relasi
  questions Question[]
  
  @@map("dimensions")
}

// Pertanyaan Kuesioner
model Question {
  id          String   @id @default(cuid())
  dimensionId String
  code        String   @unique  // Q1, Q2, ..., L1, L2
  text        String
  indicator   String   // Nama indikator
  order       Int
  
  // Relasi
  dimension Dimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  answers   Answer[]
  validityReliabilities ValidityReliability[] // TAMBAHKAN INI
  
  @@map("questions")
}

// Jawaban Responden
model Answer {
  id         String   @id @default(cuid())
  surveyId   String
  questionId String
  value      Int      // 1-5 (Likert Scale)
  createdAt  DateTime @default(now())
  
  // Relasi
  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([surveyId, questionId])
  
  @@map("answers")
}

// Hasil Analisis
model Analysis {
  id         String   @id @default(cuid())
  surveyId   String   @unique
  content    Float
  accuracy   Float
  format     Float
  easeOfUse  Float
  timeliness Float
  loyalty    Float
  totalScore Float
  createdAt  DateTime @default(now())
  
  // Relasi
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  
  @@map("analyses")
}

// ====================
// FITUR TAMBAHAN
// ====================

// Visualisasi Chart
model Visualization {
  id        String   @id @default(cuid())
  type      ChartType
  data      Json
  title     String
  createdAt DateTime @default(now())
  
  @@map("visualizations")
}

enum ChartType {
  BAR
  PIE
  HEATMAP
  LINE
}

// Export History
model Export {
  id        String   @id @default(cuid())
  userId    String
  type      ExportType
  data      Json?
  fileUrl   String?
  createdAt DateTime @default(now())
  
  // Relasi
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("exports")
}

enum ExportType {
  PDF
  CSV
  EXCEL
}

// Validitas & Reliabilitas
model ValidityReliability {
  id                String   @id @default(cuid())
  questionId        String
  rHitung           Float
  rTabel            Float
  status            String   // "Valid" | "Tidak Valid"
  cronbachAlpha     Float?
  cronbachStatus    String?  // "Reliabel" | "Cukup" | "Tidak Reliabel"
  createdAt         DateTime @default(now())
  
  // Relasi
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@map("validity_reliability")
}

// Regresi Analysis
model Regression {
  id              String   @id @default(cuid())
  dimension       String
  coefficient     Float
  tValue          Float
  pValue          Float
  significance    String   // "Signifikan" | "Tidak Signifikan"
  rSquared        Float
  adjustedRSquared Float
  createdAt       DateTime @default(now())
  
  @@map("regressions")
}