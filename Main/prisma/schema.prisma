generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.db"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Platform {
  id         Int         @id @default(autoincrement())
  name       String      @unique // Shopee / TikTok Shop
  responden  Responden[]
}

model Responden {
  id          Int           @id @default(autoincrement())
  nama        String
  umur        Int
  jenisKelamin String
  platformId  Int
  platform    Platform     @relation(fields: [platformId], references: [id])
  createdAt   DateTime      @default(now())

  taskResults TaskResult[]
  susAnswers  SUSAnswer[]
}

model Task {
  id          Int           @id @default(autoincrement())
  namaTask    String
  deskripsi   String
  createdAt   DateTime      @default(now())

  taskResults TaskResult[]
}

model TaskResult {
  id           Int       @id @default(autoincrement())
  respondenId  Int
  taskId       Int

  success      Boolean   // true = berhasil, false = gagal
  timeOnTask   Float     // dalam detik
  errorCount   Int       // jumlah error

  responden    Responden @relation(fields: [respondenId], references: [id])
  task         Task      @relation(fields: [taskId], references: [id])

  createdAt    DateTime  @default(now())
}

model SUSQuestion {
  id        Int      @id @default(autoincrement())
  question  String
  isPositive Boolean // untuk perhitungan SUS
}

model SUSAnswer {
  id           Int      @id @default(autoincrement())
  respondenId  Int
  questionId   Int
  score        Int      // 1–5

  responden    Responden   @relation(fields: [respondenId], references: [id])
  question     SUSQuestion @relation(fields: [questionId], references: [id])
}
ation(fields: [questionId], references: [id])
}
